#include <stdio.h>
int main(void) {
    int n, q, i, time = 0, completed = 0;
    int at[50], bt[50], rem[50], ct[50], wt[50], tat[50];
    float awt = 0, atat = 0;

    printf("Enter number of processes (1-50): ");
    scanf("%d", &n);
    if (n < 1 || n > 50) return 1;
    for (i = 0; i < n; i++) {
        printf("P%d arrival time and burst time: ", i+1);
        scanf("%d%d", &at[i], &bt[i]);
        if (at[i] < 0 || bt[i] <= 0) return 1;
        rem[i] = bt[i];
    }
    printf("Enter time quantum: ");
    scanf("%d", &q);
    if (q <= 0) return 1;

    while (completed < n) {
        int ran = 0;
        for (i = 0; i < n; i++) {
            if (rem[i] > 0 && at[i] <= time) {
                int slice = rem[i] < q ? rem[i] : q;
                rem[i] -= slice;
                time += slice;
                ran = 1;
                if (rem[i] == 0) {
                    ct[i] = time;
                    tat[i] = ct[i] - at[i];
                    wt[i] = tat[i] - bt[i];
                    completed++;
                }
            }
        }
        if (!ran) time++;
    }

    printf("\nPID\tAT\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n", i+1, at[i], bt[i], wt[i], tat[i]);
        awt += wt[i]; atat += tat[i];
    }
    printf("Average waiting time: %.2f\nAverage turnaround time: %.2f\n",
           awt/n, atat/n);
    return 0;
}
