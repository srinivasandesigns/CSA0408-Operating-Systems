#include <stdio.h>
int main(void){int n,f,p[100],frame[20],next=0,fault=0;
 printf("Number of page references: ");scanf("%d",&n);printf("Enter reference string:\n");for(int i=0;i<n;i++)scanf("%d",&p[i]);
 printf("Number of frames: ");scanf("%d",&f);if(f<1||f>20)return 1;for(int i=0;i<f;i++)frame[i]=-1;
 for(int i=0;i<n;i++){int hit=0;for(int j=0;j<f;j++)if(frame[j]==p[i])hit=1;
 if(!hit){frame[next]=p[i];next=(next+1)%f;fault++;}
 printf("%d:\t",p[i]);for(int j=0;j<f;j++)if(frame[j]==-1)printf("- ");else printf("%d ",frame[j]);puts(hit?"Hit":"Fault");}
 printf("Total page faults = %d\n",fault);return 0;}
