#include <stdio.h>
int main(void) {
    int n, i, time = 0, completed = 0, best;
    int at[50], bt[50], done[50] = {0}, wt[50], tat[50];
    float awt = 0, atat = 0;

    printf("Enter number of processes (1-50): ");
    scanf("%d", &n);
    if (n < 1 || n > 50) return 1;
    for (i = 0; i < n; i++) {
        printf("P%d arrival time and burst time: ", i+1);
        scanf("%d%d", &at[i], &bt[i]);
        if (at[i] < 0 || bt[i] <= 0) return 1;
    }

    while (completed < n) {
        best = -1;
        for (i = 0; i < n; i++)
            if (!done[i] && at[i] <= time &&
                (best == -1 || bt[i] < bt[best]))
                best = i;
        if (best == -1) { time++; continue; }

        wt[best] = time - at[best];
        time += bt[best];
        tat[best] = time - at[best];
        done[best] = 1;
        completed++;
    }

    printf("\nPID\tAT\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n", i+1, at[i], bt[i], wt[i], tat[i]);
        awt += wt[i]; atat += tat[i];
    }
    printf("Average waiting time: %.2f\nAverage turnaround time: %.2f\n",
           awt/n, atat/n);
    return 0;
}
