#include <stdio.h>
int main(void){int n,f,p[100],fr[20],last[20],fault=0;
 printf("Number of page references: ");scanf("%d",&n);printf("Enter reference string:\n");for(int i=0;i<n;i++)scanf("%d",&p[i]);
 printf("Number of frames: ");scanf("%d",&f);if(f<1||f>20)return 1;for(int j=0;j<f;j++)fr[j]=-1,last[j]=-1;
 for(int i=0;i<n;i++){int k=-1;for(int j=0;j<f;j++)if(fr[j]==p[i])k=j;
 if(k<0){fault++;k=0;for(int j=0;j<f;j++)if(fr[j]==-1){k=j;break;}else if(last[j]<last[k])k=j;fr[k]=p[i];}last[k]=i;
 printf("%d:\t",p[i]);for(int j=0;j<f;j++)if(fr[j]<0)printf("- ");else printf("%d ",fr[j]);puts("");}
 printf("Total page faults = %d\n",fault);return 0;}
