#include <stdio.h>
#include <string.h>
int main(int argc,char *argv[]){char pattern[100],filename[100],line[1024];FILE *fp;
 if(argc>=3){snprintf(pattern,sizeof pattern,"%s",argv[1]);snprintf(filename,sizeof filename,"%s",argv[2]);}
 else{printf("Search word: ");scanf("%99s",pattern);printf("Filename: ");scanf("%99s",filename);}
 fp=fopen(filename,"r");if(!fp){perror("fopen");return 1;}int ln=0,found=0;
 while(fgets(line,sizeof line,fp)){ln++;if(strstr(line,pattern)){printf("%d: %s",ln,line);found=1;}}
 if(!found)puts("No matching lines.");fclose(fp);return 0;}
