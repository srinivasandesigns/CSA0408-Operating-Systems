#include <stdio.h>
#include <string.h>
#define MAX 50
#define LEN 50

int main(void) {
    char files[MAX][LEN], name[LEN];
    int count = 0, choice, i, found;
    do {
        printf("\n1.Create file  2.List files  3.Delete file  4.Exit\nChoice: ");
        scanf("%d", &choice);
        if (choice == 1) {
            if (count == MAX) { puts("Directory is full."); continue; }
            printf("Enter file name: "); scanf("%49s", name);
            found = 0;
            for (i = 0; i < count; i++) if (!strcmp(files[i], name)) found = 1;
            if (found) puts("File already exists.");
            else { strcpy(files[count++], name); puts("File created."); }
        } else if (choice == 2) {
            if (!count) puts("Directory is empty.");
            for (i = 0; i < count; i++) puts(files[i]);
        } else if (choice == 3) {
            printf("Enter file name to delete: "); scanf("%49s", name);
            found = -1;
            for (i = 0; i < count; i++) if (!strcmp(files[i], name)) found = i;
            if (found == -1) puts("File not found.");
            else {
                for (i = found; i < count-1; i++) strcpy(files[i], files[i+1]);
                count--; puts("File deleted.");
            }
        }
    } while (choice != 4);
    return 0;
}
