#include <stdio.h>
int main(void){int used[100]={0},idx,n,b[50],ok=1;
 printf("Index block (0-99): ");scanf("%d",&idx);printf("Number of file blocks: ");scanf("%d",&n);
 if(idx<0||idx>=100||n<1||n>50){puts("Invalid input.");return 1;}
 printf("Enter %d data block numbers:\n",n);for(int i=0;i<n;i++)scanf("%d",&b[i]);
 if(used[idx])ok=0;for(int i=0;i<n;i++){if(b[i]<0||b[i]>=100||b[i]==idx||used[b[i]])ok=0;for(int j=0;j<i;j++)if(b[i]==b[j])ok=0;}
 if(!ok){puts("Allocation failed: invalid or occupied block.");return 0;}
 used[idx]=1;for(int i=0;i<n;i++)used[b[i]]=1;
 printf("Index block %d contains pointers to: ",idx);for(int i=0;i<n;i++)printf("%d ",b[i]);puts("");return 0;}
