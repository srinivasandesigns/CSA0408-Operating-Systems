#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>

int main(void) {
    int id = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0600);
    char *data;
    if (id == -1) { perror("shmget"); return 1; }

    data = (char *)shmat(id, NULL, 0);
    if (data == (char *)-1) { perror("shmat"); shmctl(id, IPC_RMID, NULL); return 1; }

    strcpy(data, "Hello from shared memory!");
    printf("Data written to shared memory: %s\n", data);
    printf("Data read from shared memory: %s\n", data);

    shmdt(data);
    shmctl(id, IPC_RMID, NULL);
    return 0;
}
