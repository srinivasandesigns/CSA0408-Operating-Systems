#include <stdio.h>
int main(void) {
    int n, i, time = 0, completed = 0, best;
    int at[50], bt[50], rem[50], pr[50], ct[50], wt[50], tat[50];
    float awt = 0, atat = 0;

    printf("Enter number of processes (1-50): ");
    scanf("%d", &n);
    if (n < 1 || n > 50) return 1;
    for (i = 0; i < n; i++) {
        printf("P%d arrival time, burst time, priority: ", i+1);
        scanf("%d%d%d", &at[i], &bt[i], &pr[i]);
        if (at[i] < 0 || bt[i] <= 0) return 1;
        rem[i] = bt[i];
    }

    while (completed < n) {
        best = -1;
        for (i = 0; i < n; i++)
            if (rem[i] > 0 && at[i] <= time &&
                (best == -1 || pr[i] < pr[best]))
                best = i;

        if (best == -1) { time++; continue; }
        rem[best]--;
        time++;
        if (rem[best] == 0) {
            ct[best] = time;
            tat[best] = ct[best] - at[best];
            wt[best] = tat[best] - bt[best];
            completed++;
        }
    }

    printf("\nPID\tAT\tBT\tPriority\tWT\tTAT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\n",
               i+1, at[i], bt[i], pr[i], wt[i], tat[i]);
        awt += wt[i]; atat += tat[i];
    }
    printf("Average waiting time: %.2f\nAverage turnaround time: %.2f\n",
           awt/n, atat/n);
    return 0;
}
