#include <stdio.h>
#include <sys/stat.h>
#include <unistd.h>
#include <pwd.h>
#include <grp.h>
int main(int argc,char *argv[]){const char *file=argc>1?argv[1]:"permission_demo.txt";FILE *fp=fopen(file,"a");if(!fp){perror("fopen");return 1;}fclose(fp);
 if(chmod(file,0644)<0){perror("chmod");return 1;}struct stat st;if(stat(file,&st)<0){perror("stat");return 1;}
 struct passwd *pw=getpwuid(getuid());struct group *gr=getgrgid(getgid());
 printf("File: %s\nOwner user: %s\nOwner group: %s\n",file,pw?pw->pw_name:"unknown",gr?gr->gr_name:"unknown");
 printf("Permissions: ");char *bits="rwxrwxrwx";for(int i=0;i<9;i++)putchar((st.st_mode&(1<<(8-i)))?bits[i]:'-');
 printf("\nNumeric mode: %04o\n",st.st_mode&0777);
 puts("Linux user classes: owner (u), group (g), others (o).");puts("Permission bits: read (r=4), write (w=2), execute (x=1).");
 puts("Example: chmod 755 file gives rwxr-xr-x.");return 0;}
