#include <stdio.h>
int main(void){int disk[100]={0},start,len,ok=1;
 printf("Starting block (0-99): ");scanf("%d",&start);printf("Number of blocks: ");scanf("%d",&len);
 if(start<0||len<1||start+len>100){puts("Invalid range.");return 1;}
 for(int i=start;i<start+len;i++)if(disk[i])ok=0;
 if(!ok){puts("Allocation failed: block already occupied.");return 0;}
 for(int i=start;i<start+len;i++)disk[i]=1;
 printf("File allocated sequentially at blocks: ");for(int i=start;i<start+len;i++)printf("%d ",i);puts("");return 0;}
