#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>
#include <errno.h>
int main(void){char name[100],buf[512];int fd;ssize_t n;
 printf("Filename to create/open: ");scanf("%99s",name);
 fd=open(name,O_CREAT|O_RDWR,0644);if(fd<0){perror("open");return 1;}
 printf("Enter text (one line): ");getchar();if(!fgets(buf,sizeof buf,stdin)){close(fd);return 1;}
 if(write(fd,buf,strlen(buf))<0)perror("write");
 if(lseek(fd,0,SEEK_SET)<0)perror("lseek");
 puts("File contents:");while((n=read(fd,buf,sizeof(buf)-1))>0){buf[n]='\0';printf("%s",buf);}
 if(n<0)perror("read");if(close(fd)<0)perror("close");return 0;}
