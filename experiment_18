#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#define SIZE 5
int buffer[SIZE], in=0, out=0, items=10;
sem_t empty_slots, full_slots; pthread_mutex_t lock;
void *producer(void *arg){
    for(int x=1;x<=items;x++){sem_wait(&empty_slots);pthread_mutex_lock(&lock);
        buffer[in]=x;printf("Produced: %d\n",x);in=(in+1)%SIZE;
        pthread_mutex_unlock(&lock);sem_post(&full_slots);}
    return NULL;
}
void *consumer(void *arg){
    for(int x=1;x<=items;x++){sem_wait(&full_slots);pthread_mutex_lock(&lock);
        int v=buffer[out];printf("Consumed: %d\n",v);out=(out+1)%SIZE;
        pthread_mutex_unlock(&lock);sem_post(&empty_slots);}
    return NULL;
}
int main(void){pthread_t p,c;sem_init(&empty_slots,0,SIZE);sem_init(&full_slots,0,0);pthread_mutex_init(&lock,NULL);
    pthread_create(&p,NULL,producer,NULL);pthread_create(&c,NULL,consumer,NULL);
    pthread_join(p,NULL);pthread_join(c,NULL);sem_destroy(&empty_slots);sem_destroy(&full_slots);pthread_mutex_destroy(&lock);return 0;}
