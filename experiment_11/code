#include <stdio.h>
#include <pthread.h>

void *task(void *arg) {
    printf("Hello from %s\n", (char *)arg);
    return NULL;
}

int main(void) {
    pthread_t t1, t2;
    char a[] = "Thread 1", b[] = "Thread 2";

    if (pthread_create(&t1, NULL, task, a) != 0 ||
        pthread_create(&t2, NULL, task, b) != 0) {
        printf("Thread creation failed\n");
        return 1;
    }
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    printf("Main thread: both threads completed.\n");
    return 0;
}
